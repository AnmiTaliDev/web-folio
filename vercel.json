{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": "{server,catalog,prompts,legal}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/((?!api/|assets/).*)", "destination": "/index.html" }]
}
